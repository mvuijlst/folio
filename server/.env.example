# Settings for the Folio server. Copy to server/.env and fill in; .env is never committed.
#
# Django does not read this file itself. In production the systemd units load it, and the
# deploy sources it. For local work, load it into the shell first:
#   set -a; . ./.env; set +a
# So: one KEY=value per line, no spaces around =, and quotes around a value with spaces
# or < > in it.

# ── Django ─────────────────────────────────────────────────────────────────────

# Required unless DJANGO_DEBUG=1. A long random string, e.g. from:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# "1" for local development only: debug pages, and a throwaway secret key if none is set.
DJANGO_DEBUG=0

# The host names the server answers to, comma-separated. The first one is the one the
# deploy checks after restarting the server.
DJANGO_ALLOWED_HOSTS=folio.example.org

# ── Publishing to the booklog (optional; see docs/booklog.md) ──────────────────

# A clone of the booklog that only this server writes to, outside the web root.
# Leave empty and nothing is published.
BOEKEN_REPO_PATH=

# Who the booklog commits are by.
BOEKEN_GIT_AUTHOR="Folio <folio@localhost>"

# "1" to push those commits, which makes them public. Without it they are only made.
BOEKEN_PUSH=0

# ── The assistant (optional) ───────────────────────────────────────────────────

# Without a key the app does not offer the assistant (describing a book, reading a
# photographed cover, Suggest).
OPENAI_API_KEY=

# The model it asks.
OPENAI_MODEL=gpt-5.5

# How long it may think about a photographed cover: "low" by default, empty for the
# model's own default.
OPENAI_COVER_EFFORT=low
