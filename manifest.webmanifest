{
  "name": "Folio",
  "short_name": "Folio",
  "description": "Your books on lists: library, to read, reading, read, lent out. Scan a barcode to add one.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1e1945",
  "theme_color": "#1e1945",
  "categories": ["books", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "picture", "accept": ["image/*"] }]
    }
  },
  "shortcuts": [
    { "name": "Scan a book", "short_name": "Scan", "url": "./?scan=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
